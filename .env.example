# Server
PORT=3000
SESSION_SECRET=generate-a-random-secret-at-least-32-characters
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/printdrop
# Google Drive OAuth2 (the refresh-token user's Drive owns the uploaded files)
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost
GOOGLE_REFRESH_TOKEN=your-oauth-refresh-token
# Optional: uploads go to this Drive folder (otherwise the user's root)
GOOGLE_DRIVE_FOLDER_ID=
# Optional first shop owner (omit to create one via /owner.html)
OWNER_USERNAME=
OWNER_PASSWORD=
DEFAULT_SHOP_SLUG=default
DEFAULT_SHOP_NAME=PrintDrop

# Upload settings
# Auto-cleanup time in minutes
UPLOAD_TTL_MINUTES=30
MAX_UPLOAD_FILES=10
# Allowed range: 50-100 MB. Defaults to 80 MB if omitted.
MAX_FILE_SIZE_MB=80
MAX_REQUEST_SIZE_MB=100

# Base URL (used for QR code generation)
# Change this to your public URL when deploying
BASE_URL=http://localhost:3000
